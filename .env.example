# ── Frontend (Vite) ──────────────────────────────────────────
# true = no real Razorpay charge (full flow still works)
VITE_FORCE_DEMO=true

# Optional when API is on another domain
# VITE_API_BASE=https://api.yourdomain.com

# WhatsApp support (country code + number, digits only)
# VITE_SUPPORT_WHATSAPP=919999999999

# ── Backend (server/index.js) ────────────────────────────────
PORT=8787

# Razorpay live/test keys — when set, demoMode turns off automatically
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=xxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxx

# Admin desk token for /admin + /api/admin/orders
ADMIN_TOKEN=blackbox-admin

SUPPORT_EMAIL=support@blackboxfx.io
SUPPORT_WHATSAPP=919999999999
ACCESS_SLA=2 hours

# Optional: Slack/Discord/Make.com webhook on paid order
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/blackboxfx
